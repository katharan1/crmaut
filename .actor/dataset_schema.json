{
  "actorSpecification": 1,
  "fields": {
    "type": "object",
    "properties": {
      "source": { "type": "string", "enum": ["app_store", "google_play", "reddit", "facebook", "instagram", "linkedin"] },
      "id": { "type": "string", "description": "Unique per item, prefixed with the source." },
      "date": { "type": "string", "description": "ISO 8601, UTC." },
      "text": { "type": "string" },
      "rating": { "type": ["integer", "null"], "description": "1-5 stars, app stores only." },
      "context": { "type": ["string", "null"], "description": "Post or thread the comment replies to; app version for reviews." },
      "url": { "type": ["string", "null"], "description": "Link to the item, never to its author." }
    },
    "required": ["source", "id", "date", "text"]
  },
  "views": {
    "overview": {
      "title": "Feedback",
      "transformation": {
        "fields": ["date", "source", "rating", "text", "context", "url"]
      },
      "display": {
        "component": "table",
        "properties": {
          "url": { "format": "link" }
        }
      }
    }
  }
}
